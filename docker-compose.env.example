# Example environment file for Docker Compose
# Copy this file to .env and update the values before running docker-compose

# Database Configuration
MYSQL_HOST=db-mysql-match-do-user-16025444-0.c.db.ondigitalocean.com
MYSQL_PORT=25060
MYSQL_DATABASE=defaultdb
MYSQL_USER=doadmin
MYSQL_PASSWORD=your_password_here

# UTR API Configuration
# Replace with your actual UTR API token
UTR_API_TOKEN=your_utr_api_token_here

# Application Configuration
SERVER_PORT=8080
JAVA_OPTS=-Xmx512m -Xms256m
